# =========================================================================
# Variables de entorno - Mantenimiento Vehículos Pro (Docker)
# =========================================================================

# Perfil de Spring Boot (prod / dev)
SPRING_PROFILE=prod

# --- Base de datos LOCAL (Docker) ---
LOCAL_DB_NAME=mantenimiento_db
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres123
LOCAL_DB_PORT=5432

# --- Conexión a Base de Datos (Por defecto apunta al contenedor PostgreSQL local) ---
DB_URL=jdbc:postgresql://postgres:5432/mantenimiento_db
DB_USERNAME=postgres
DB_PASSWORD=postgres123

# Si deseas que el backend Docker se conecte a Neon en la nube, descomenta y completa:
# DB_URL=jdbc:postgresql://ep-lingering-poetry-arqpak4r-pooler.c-4.us-west-2.aws.neon.tech/neondb?sslmode=require&prepareThreshold=0
# DB_USERNAME=neondb_owner
# DB_PASSWORD=tu_password_de_neon
